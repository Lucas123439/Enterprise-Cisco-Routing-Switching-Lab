R2#configure terminal
Enter configuration commands, one per line.  End with CNTL/Z.

!
! OSPF Process 1
!

R2(config)#router ospf 1
R2(config-router)#router-id 2.2.2.2
R2(config-router)#network 10.23.23.0 0.0.0.3 area 0
R2(config-router)#exit

!
! Passive Interface
!

R2(config)#router ospf 1
R2(config-router)#passive-interface Loopback1
R2(config-router)#exit

!
! OSPF Authentication
!

R2(config)#interface GigabitEthernet0/0
R2(config-if)#ip ospf authentication message-digest
R2(config-if)#ip ospf message-digest-key 1 md5 CCNP
R2(config-if)#exit

!
! Area 10
!

R2(config)#router ospf 1
R2(config-router)#network <area-10-network> <wildcard> area 10
R2(config-router)#exit

!
! Area 10 Summarization
!

R2(config)#router ospf 1
R2(config-router)#area 10 range <summary-network> <summary-mask>
R2(config-router)#exit

!
! Default Route
!

R2(config)#ip route 0.0.0.0 0.0.0.0 <next-hop>

R2(config)#router ospf 1
R2(config-router)#default-information originate
R2(config-router)#end

R2#write memory



